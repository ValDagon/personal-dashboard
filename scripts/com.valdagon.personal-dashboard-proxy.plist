<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.valdagon.personal-dashboard-proxy</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/valentin/Work/personal-dashboard/scripts/wake_proxy.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>Sockets</key>
    <dict>
        <key>Listener</key>
        <dict>
            <key>SockServiceName</key>
            <string>8501</string>
            <key>SockNodeType</key>
            <string>IPv4</string>
        </dict>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/valentin/Library/Logs/personal-dashboard/proxy.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/valentin/Library/Logs/personal-dashboard/proxy.log</string>
    <key>WorkingDirectory</key>
    <string>/Users/valentin/Work/personal-dashboard</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
